{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biochain.ai/cocoon/schemas/standalone_preset.schema.json",
  "title": "Harmonic Cocoon standalone preset",
  "description": "A pre-calculated geometric sequence a puck can run with no orchestrator. Compiled into firmware by standalone_presets/compile_presets.py.",
  "type": "object",
  "required": ["id", "slug", "name", "version", "loop", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "id": {"type": "integer", "minimum": 1, "maximum": 65534},
    "slug": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "maxLength": 48},
    "description": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "target_state": {"enum": ["delta", "theta", "alpha", "beta", "gamma"]},
    "loop": {"type": "boolean"},
    "photosensitive_consent_required": {"type": "boolean"},
    "duration_hint_min": {"type": "number", "minimum": 0},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["hold_s", "ramp_s", "fc", "fe", "amp", "mode", "modality"],
        "additionalProperties": false,
        "properties": {
          "hold_s": {"type": "number", "minimum": 0},
          "ramp_s": {"type": "number", "minimum": 0},
          "fc": {"type": "number", "minimum": 40, "maximum": 1500},
          "fe": {"type": "number", "minimum": 0.5, "maximum": 45},
          "amp": {"type": "number", "minimum": 0, "maximum": 1},
          "pan": {"type": "number", "minimum": -1, "maximum": 1},
          "mode": {"enum": ["binaural", "isochronic", "monaural", "bilateral", "pulse", "continuous"]},
          "modality": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["audio", "photonic", "haptic", "coil"]}
          },
          "note": {"type": "string"}
        }
      }
    }
  }
}
