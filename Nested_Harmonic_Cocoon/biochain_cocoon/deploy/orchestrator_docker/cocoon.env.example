# Copy to cocoon.env (git-ignored) and adjust.
COCOON_HTTP_HOST=0.0.0.0
COCOON_HTTP_PORT=8640
# --- Sign-in: the same accounts as the BioChain console (Firebase Auth) ---
# Only credentials are shared; the cocoon never reads BioChain's Firestore/roles.
COCOON_AUTH=firebase
# COCOON_FIREBASE_PROJECT_ID=biochain-ai        # defaults target the BioChain project
# Cocoon roles (hub-local, independent of BioChain roles). Find your uid in the Hub accounts module
# or in Firebase console → Authentication → Users.
COCOON_OWNER_UIDS=
# Optional: restrict which BioChain accounts may use this hub (uids, emails, or @domain)
COCOON_ALLOWED_EMAILS=
COCOON_ALLOWED_UIDS=
# Machine credential for wearable bridges and scripts (Bearer token):
COCOON_API_TOKEN=change-me-to-a-long-random-string
# udp | serial | loopback
COCOON_TRANSPORT=udp
COCOON_UDP_BROADCAST=255.255.255.255
COCOON_UDP_PORT=47632
# COCOON_SERIAL_PORT=/dev/ttyACM0
COCOON_TICK_HZ=50
COCOON_PI6_MAX_RATE_HZ=12
# Optional BioChain AI bridge (session receipts). Off keeps the cocoon fully standalone.
COCOON_BIOCHAIN_BRIDGE=0
# BIOCHAIN_PROTOCOL_PATH=/biochain/protocol   # mount BioChain-AI/protocol here to enable kernel cross-checks
