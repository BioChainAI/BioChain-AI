# Copy to cocoon.env (git-ignored) and adjust.
COCOON_HTTP_HOST=0.0.0.0
COCOON_HTTP_PORT=8640
# Required whenever the hub listens beyond localhost:
COCOON_API_TOKEN=change-me-to-a-long-random-string
# udp | serial | loopback
COCOON_TRANSPORT=udp
COCOON_UDP_BROADCAST=255.255.255.255
COCOON_UDP_PORT=47632
# COCOON_SERIAL_PORT=/dev/ttyACM0
COCOON_TICK_HZ=50
COCOON_PI6_MAX_RATE_HZ=12
# Optional BioChain AI bridge (session receipts). Off keeps the cocoon fully standalone.
COCOON_BIOCHAIN_BRIDGE=0
# BIOCHAIN_PROTOCOL_PATH=/biochain/protocol   # mount BioChain-AI/protocol here to enable kernel cross-checks
